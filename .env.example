# Copy this file to .env. Never commit .env or actual API keys.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key

# Replace these with exact model IDs available to your API accounts.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_JUDGE_MODEL=gpt-6.2-astra
# Set to off if your selected Claude model does not support output_config.effort.
ANTHROPIC_EFFORT=medium
